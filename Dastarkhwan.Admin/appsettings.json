{
  "Identity": {
    "Jwt": {
      "Issuer": "Dastarkhwan",
      "Audience": "Dastarkhwan",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    },
    "EmailVerification": {
      "TokenHours": 24,
      "ResendCooldownSeconds": 60
    },
    "Lockout": {
      "Threshold": 5,
      "DurationMinutes": 15
    },
    "PasswordReset": {
      "TokenMinutes": 60
    },
    "RateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Tenant": {
    "MaxSettingsPerTenant": 200,
    "InfoCacheSeconds": 30,
    "MembershipCacheSeconds": 30,
    "Resolution": {
      "HeaderName": "X-Tenant-Id",
      "ClaimType": "tenant_id"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  }
}
