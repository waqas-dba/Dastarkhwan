# Dastarkhwan Development Environment Configuration
# This file documents the required environment variables and user secrets.
# DO NOT COMMIT ACTUAL SECRETS - use `dotnet user-secrets` instead.

# ============================================
# User Secrets (set via: dotnet user-secrets set "Key" "Value" --project Dastarkhwan.Web)
# ============================================

# Identity Seed
Identity:Seed:AdminEmail=admin@example.com
Identity:Seed:AdminPassword=a-long-test-password
Identity:Seed:AdminMobile=+923000000000
Identity:Seed:AdminDisplayName=Platform Administrator

# JWT Configuration
Identity:Jwt:SigningKey=K3WFXWfpftOu9gxRZYVX774n7qPR44pQ+ERsnmvFV3M=
Identity:Jwt:Issuer=Dastarkhwan
Identity:Jwt:Audience=Dastarkhwan
Identity:Jwt:AccessTokenMinutes=15
Identity:Jwt:RefreshTokenDays=30

# Database
ConnectionStrings:Default=Host=127.0.0.1;Database=dastarkhwan_db;Username=dastarkhwan;Password=dastarkhwan_dev_only

# ============================================
# appsettings.json (committed, non-secret defaults)
# ============================================

# Email
Email:Provider=Console
Email:BaseUrl=http://localhost:5000

# Identity
Identity:EmailVerification:TokenHours=24
Identity:EmailVerification:ResendCooldownSeconds=60
Identity:Lockout:Threshold=5
Identity:Lockout:DurationMinutes=15
Identity:PasswordReset:TokenMinutes=60
Identity:RateLimit:PermitLimit=30
Identity:RateLimit:WindowSeconds=60

# Tenant
Tenant:MaxSettingsPerTenant=200
Tenant:InfoCacheSeconds=30
Tenant:MembershipCacheSeconds=30
Tenant:Resolution:HeaderName=X-Tenant-Id
Tenant:Resolution:ClaimType=tenant_id
Tenant:Resolution:TrustHeader=true
Tenant:Resolution:ExcludedPathPrefixes=/identity,/health,/favicon.ico,/.well-known

# Forwarded Headers
ForwardedHeaders:KnownProxies=

# CORS
Cors:AllowedOrigins=http://localhost:3000

# ============================================
# Development URLs
# ============================================
# HTTPS: https://localhost:53584
# HTTP:  http://localhost:53585

# ============================================
# PostgreSQL (development)
# ============================================
# Host: 127.0.0.1
# Port: 5432
# Database: dastarkhwan_db
# User: dastarkhwan
# Password: dastarkhwan_dev_only

# Schemas: identity, access, tenant

# ============================================
# Quick Test Commands
# ============================================
# Health check:
#   curl -k https://localhost:53584/health/live

# Login:
#   curl -k -X POST https://localhost:53584/identity/auth/login \
#     -H "Content-Type: application/json" \
#     -d '{"email":"admin@example.com","password":"a-long-test-password"}'

# Get current user (with token):
#   curl -k https://localhost:53584/identity/auth/me -H "Authorization: Bearer <token>"

# Platform permissions:
#   curl -k https://localhost:53584/access/me -H "Authorization: Bearer <token>"

# User's tenants:
#   curl -k https://localhost:53584/tenants/me -H "Authorization: Bearer <token>"

# Create tenant:
#   curl -k -X POST https://localhost:53584/tenants \
#     -H "Content-Type: application/json" \
#     -H "Authorization: Bearer <token>" \
#     -d '{"name":"Test","slug":"test","activateImmediately":true,"ownerUserId":"<user-id>"}'

# Tenant-scoped (with X-Tenant-Id header):
#   curl -k https://localhost:53584/tenants/current \
#     -H "Authorization: Bearer <token>" \
#     -H "X-Tenant-Id: <tenant-id>"