                  "raw": "{{baseUrl}}/identity/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["identity", "auth", "login"]
                },
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"captchaToken\": \"{{captchaToken}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const json = pm.response.json();",
                      "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                      "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                      "  if (json.user?.id) pm.collectionVariables.set('userId', json.user.id);",
                      "  if (json.user?.email) pm.collectionVariables.set('email', json.user.email);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
