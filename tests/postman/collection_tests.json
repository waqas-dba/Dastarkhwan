{
  "info": {
    "name": "Dastarkhwan — Working Test Suite",
    "description": "Self-contained. Requires: seeded admin, bootstrap, active environment. Fails fast with actionable diagnostics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runSuffix')) pm.environment.set('runSuffix', pm.variables.replaceIn('{{$timestamp}}'));",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.variables.replaceIn('{{$guid}}') });",
          "const missing = ['baseUrl','adminEmail','adminPassword'].filter(k => !pm.variables.get(k));",
          "if (missing.length) console.error('ENV MISSING: ' + missing.join(', ') + ' — activate the environment in the top-right dropdown.');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Preflight",
      "item": [
        {
          "name": "Health - Live",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET", "header": [],
            "url": {"raw":"{{baseUrl}}/health/live","host":["{{baseUrl}}"],"path":["health","live"]}
          }
        },
        {
          "name": "Admin Login",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('admin login succeeds', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "    const b = pm.response.json();",
            "    pm.test('has accessToken',  () => pm.expect(b.accessToken).to.be.a('string').and.not.empty);",
            "    pm.test('has refreshToken', () => pm.expect(b.refreshToken).to.be.a('string').and.not.empty);",
            "    pm.test('has user.id',      () => pm.expect(b.user).to.be.an('object'));",
            "    pm.environment.set('adminAccessToken',  b.accessToken);",
            "    pm.environment.set('adminRefreshToken', b.refreshToken);",
            "    pm.environment.set('adminUserId',       b.user.id);",
            "} else {",
            "    const e = (()=>{try{return pm.response.json()}catch{return{}}})();",
            "    pm.test('login diagnostic', () => pm.expect.fail(",
            "        'Login failed (' + pm.response.code + ' ' + (e.errorCode||'') + '). ' +",
            "        'Check: (1) appsettings.Development.json Identity:Seed:AdminEmail matches ' + pm.environment.get('adminEmail') + ', ' +",
            "        '(2) restart the app and confirm \"administrator was created\" or \"already exists\" in the log, ' +",
            "        '(3) if DB row exists but password unknown, reset via HashGen + UPDATE.'",
            "    ));",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},
            "url": {"raw":"{{baseUrl}}/identity/auth/login","host":["{{baseUrl}}"],"path":["identity","auth","login"]}
          }
        },
        {
          "name": "Verify Platform Admin Role",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "    const b = pm.response.json();",
            "    pm.test('isMember',             () => pm.expect(b.isMember).to.eql(true));",
            "    pm.test('has platform.members.manage', () => pm.expect(b.permissions).to.include('platform.members.manage'));",
            "} else {",
            "    pm.test('role diagnostic', () => pm.expect.fail(",
            "        'Admin has no platform role. Add the BootstrapInitialPlatformAdminAsync call to Program.cs (see Step 1) and restart.'",
            "    ));",
            "}"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{adminAccessToken}}","type":"string"}]},
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/access/me","host":["{{baseUrl}}"],"path":["access","me"]}
          }
        }
      ]
    },
    {
      "name": "01 - Create Users",
      "item": [
        {
          "name": "Set Run IDs",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.environment.set('userAEmail', 'usera+' + pm.environment.get('runSuffix') + '@test.local');",
            "pm.environment.set('userBEmail', 'userb+' + pm.environment.get('runSuffix') + '@test.local');",
            "pm.test('suffix', () => pm.expect(pm.environment.get('runSuffix')).to.be.a('string').and.not.empty);"
          ]}}],
          "request": {
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/health/live","host":["{{baseUrl}}"],"path":["health","live"]}
          }
        },
        {
          "name": "Create User A",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('201 created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) {",
            "    const b = pm.response.json();",
            "    pm.environment.set('userAUserId', b.id);",
            "    pm.environment.set('userAEmail',  b.email);",
            "} else {",
            "    const e = (()=>{try{return pm.response.json()}catch{return{}}})();",
            "    pm.test('user A diagnostic', () => pm.expect.fail(pm.response.code + ' ' + (e.errorCode||'') + ': ' + (e.detail||'')));",
            "}"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{adminAccessToken}}","type":"string"}]},
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"UserAPass123!\",\n  \"mobile\": \"+923001110001\",\n  \"displayName\": \"Test User A\",\n  \"isActive\": true\n}"},
            "url":{"raw":"{{baseUrl}}/identity/users","host":["{{baseUrl}}"],"path":["identity","users"]}
          }
        },
        {
          "name": "Create User B",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('201 created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) {",
            "    const b = pm.response.json();",
            "    pm.environment.set('userBUserId', b.id);",
            "    pm.environment.set('userBEmail',  b.email);",
            "} else {",
            "    const e = (()=>{try{return pm.response.json()}catch{return{}}})();",
            "    pm.test('user B diagnostic', () => pm.expect.fail(pm.response.code + ' ' + (e.errorCode||'') + ': ' + (e.detail||'')));",
            "}"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{adminAccessToken}}","type":"string"}]},
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"email\": \"{{userBEmail}}\",\n  \"password\": \"UserBPass123!\",\n  \"mobile\": \"+923002220002\",\n  \"displayName\": \"Test User B\",\n  \"isActive\": true\n}"},
            "url":{"raw":"{{baseUrl}}/identity/users","host":["{{baseUrl}}"],"path":["identity","users"]}
          }
        }
      ]
    },
    {
      "name": "02 - Login Users",
      "item": [
        {
          "name": "Login User A",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "    const b = pm.response.json();",
            "    pm.environment.set('userAAccessToken',  b.accessToken);",
            "    pm.environment.set('userARefreshToken', b.refreshToken);",
            "}"
          ]}}],
          "request": {
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"UserAPass123!\"\n}"},
            "url":{"raw":"{{baseUrl}}/identity/auth/login","host":["{{baseUrl}}"],"path":["identity","auth","login"]}
          }
        },
        {
          "name": "Login User B",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "    pm.environment.set('userBAccessToken', pm.response.json().accessToken);",
            "}"
          ]}}],
          "request": {
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"email\": \"{{userBEmail}}\",\n  \"password\": \"UserBPass123!\"\n}"},
            "url":{"raw":"{{baseUrl}}/identity/auth/login","host":["{{baseUrl}}"],"path":["identity","auth","login"]}
          }
        }
      ]
    },
    {
      "name": "03 - Create Tenants",
      "item": [
        {
          "name": "Create Tenant A",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('201', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) {",
            "    const b = pm.response.json();",
            "    pm.environment.set('tenantAId',   b.id);",
            "    pm.environment.set('tenantASlug', b.slug);",
            "} else {",
            "    const e = (()=>{try{return pm.response.json()}catch{return{}}})();",
            "    pm.test('tenant A diagnostic', () => pm.expect.fail(pm.response.code + ' ' + (e.errorCode||'') + ': ' + (e.detail||'')));",
            "}"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{adminAccessToken}}","type":"string"}]},
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"name\": \"Tenant A {{runSuffix}}\",\n  \"slug\": \"tenant-a-{{runSuffix}}\",\n  \"activateImmediately\": true,\n  \"ownerUserId\": \"{{userAUserId}}\"\n}"},
            "url":{"raw":"{{baseUrl}}/tenants","host":["{{baseUrl}}"],"path":["tenants"]}
          }
        },
        {
          "name": "Create Tenant B",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('201', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) {",
            "    const b = pm.response.json();",
            "    pm.environment.set('tenantBId',   b.id);",
            "    pm.environment.set('tenantBSlug', b.slug);",
            "}"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{adminAccessToken}}","type":"string"}]},
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"name\": \"Tenant B {{runSuffix}}\",\n  \"slug\": \"tenant-b-{{runSuffix}}\",\n  \"activateImmediately\": true,\n  \"ownerUserId\": \"{{userBUserId}}\"\n}"},
            "url":{"raw":"{{baseUrl}}/tenants","host":["{{baseUrl}}"],"path":["tenants"]}
          }
        },
        {
          "name": "Re-Login User A (tenant claim)",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) pm.environment.set('userAAccessToken', pm.response.json().accessToken);"
          ]}}],
          "request": {
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"UserAPass123!\"\n}"},
            "url":{"raw":"{{baseUrl}}/identity/auth/login","host":["{{baseUrl}}"],"path":["identity","auth","login"]}
          }
        },
        {
          "name": "Re-Login User B (tenant claim)",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) pm.environment.set('userBAccessToken', pm.response.json().accessToken);"
          ]}}],
          "request": {
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"email\": \"{{userBEmail}}\",\n  \"password\": \"UserBPass123!\"\n}"},
            "url":{"raw":"{{baseUrl}}/identity/auth/login","host":["{{baseUrl}}"],"path":["identity","auth","login"]}
          }
        }
      ]
    },
    {
      "name": "04 - Tenant Isolation",
      "item": [
        {
          "name": "User A sees their own tenant",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "    pm.test('is tenant A', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('tenantAId')));",
            "}"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{userAAccessToken}}","type":"string"}]},
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/tenants/current","host":["{{baseUrl}}"],"path":["tenants","current"]}
          }
        },
        {
          "name": "User A cannot see Tenant B",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('403 cross-tenant', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{userAAccessToken}}","type":"string"}]},
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/tenants/{{tenantBId}}","host":["{{baseUrl}}"],"path":["tenants","{{tenantBId}}"]}
          }
        },
        {
          "name": "User B sees their own tenant",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "    pm.test('is tenant B', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('tenantBId')));",
            "}"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{userBAccessToken}}","type":"string"}]},
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/tenants/current","host":["{{baseUrl}}"],"path":["tenants","current"]}
          }
        },
        {
          "name": "User B cannot see Tenant A",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('403 cross-tenant', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{userBAccessToken}}","type":"string"}]},
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/tenants/{{tenantAId}}","host":["{{baseUrl}}"],"path":["tenants","{{tenantAId}}"]}
          }
        }
      ]
    },
    {
      "name": "05 - Access Control",
      "item": [
        {
          "name": "Owner lists roles in Tenant A",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('200', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "    pm.test('Owner role present', () => pm.expect(pm.response.json().some(r => r.name === 'Owner')).to.eql(true));",
            "}"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{userAAccessToken}}","type":"string"}]},
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/access/roles","host":["{{baseUrl}}"],"path":["access","roles"]}
          }
        },
        {
          "name": "Owner creates a role",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('201', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) {",
            "    const b = pm.response.json();",
            "    pm.environment.set('newRoleId', b.id);",
            "    pm.environment.set('newRoleConcurrency', b.concurrencyStamp);",
            "}"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{userAAccessToken}}","type":"string"}]},
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"name\": \"Temp {{runSuffix}}\",\n  \"description\": \"temp\",\n  \"permissions\": [\"sales.create\"]\n}"},
            "url":{"raw":"{{baseUrl}}/access/roles","host":["{{baseUrl}}"],"path":["access","roles"]}
          }
        },
        {
          "name": "Owner deletes the role",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('204 or 200', () => pm.expect([200,204]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{userAAccessToken}}","type":"string"}]},
            "method":"DELETE","header":[],
            "url":{"raw":"{{baseUrl}}/access/roles/{{newRoleId}}","host":["{{baseUrl}}"],"path":["access","roles","{{newRoleId}}"]}
          }
        }
      ]
    },
    {
      "name": "06 - Security",
      "item": [
        {
          "name": "Anonymous /access/me → 401",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/access/me","host":["{{baseUrl}}"],"path":["access","me"]}
          }
        },
        {
          "name": "Anonymous /tenants → 401",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/tenants","host":["{{baseUrl}}"],"path":["tenants"]}
          }
        },
        {
          "name": "Forged JWT → 401",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"not.a.real.jwt","type":"string"}]},
            "method":"GET","header":[],
            "url":{"raw":"{{baseUrl}}/identity/auth/me","host":["{{baseUrl}}"],"path":["identity","auth","me"]}
          }
        },
        {
          "name": "Wrong password → 401",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('401', () => pm.response.to.have.status(401));",
            "pm.test('errorCode', () => pm.expect(pm.response.json().errorCode).to.eql('auth.invalid_credentials'));"
          ]}}],
          "request": {
            "method":"POST",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"DefinitelyWrong999!\"\n}"},
            "url":{"raw":"{{baseUrl}}/identity/auth/login","host":["{{baseUrl}}"],"path":["identity","auth","login"]}
          }
        },
        {
          "name": "Self-deactivation blocked → 403",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
            "pm.test('403 or 409', () => pm.expect([403,409]).to.include(pm.response.code));"
          ]}}],
          "request": {
            "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{adminAccessToken}}","type":"string"}]},
            "method":"PUT",
            "header":[{"key":"Content-Type","value":"application/json"}],
            "body":{"mode":"raw","raw":"{\n  \"isActive\": false\n}"},
            "url":{"raw":"{{baseUrl}}/identity/users/{{adminUserId}}","host":["{{baseUrl}}"],"path":["identity","users","{{adminUserId}}"]}
          }
        }
      ]
    }
  ],
  "variable": [
    {"key":"baseUrl","value":"https://localhost:53584"}
  ]
}